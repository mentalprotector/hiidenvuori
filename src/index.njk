.home-location__wrap {
  max-width: 84.5rem;
  margin: 0 auto;
  padding: 74px 1rem 72px;
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(320px, .85fr);
  gap: 2rem;
  align-items: stretch;
}

.home-location__map,
.home-location__card {
  min-height: 298px;
  border-radius: 8px;
  overflow: hidden;
}

.home-location__map {
  position: relative;
  background: #dbe7f4;
}

.home-location__map iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.home-location__fallback {
  position: absolute;
  left: 16px;
  bottom: 16px;
  width: min(280px, calc(100% - 32px));
  padding: 18px 14px;
  border-radius: 8px;
  background: rgba(255,255,255,.92);
  color: #102748;
  font-family: FontParagraph, Arial, sans-serif;
}

.home-location__fallback-title {
  margin: 0 0 .55rem;
  font-weight: 800;
  font-size: .95rem;
}

.home-location__fallback-text {
  margin: 0 0 1rem;
  color: #2c4263;
  font-size: .82rem;
  line-height: 1.35;
}

.home-location__fallback-link {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  padding: 0 16px;
  border-radius: 17px;
  background: #3384bf;
  color: #fff;
  font-size: .82rem;
  font-weight: 800;
  text-decoration: none;
}

.home-location__card {
  padding: 28px 24px;
  background: #f3f6fc;
  color: #102748;
}

.home-location__title {
  margin: 0 0 2rem;
  color: #243b5c;
  font-family: FontHeader, Arial, sans-serif;
  font-size: 1.75rem;
  font-weight: 800;
  line-height: 1.18;
}

.home-location__title span {
  color: #3384bf;
}

.home-location__list {
  margin: 0 0 1.25rem;
  padding: 0;
  list-style: none;
  color: #102748;
  font: 500 .95rem/1.45 FontParagraph, Arial, sans-serif;
}

.home-location__list li::before {
  content: "•";
  margin-right: .45rem;
  color: #3384bf;
}

.home-location__list a {
  color: #0067fa;
}

.home-location__phones {
  display: grid;
  gap: .35rem;
}

.home-location__phone {
  color: #102748;
  font-family: FontHeader, Arial, sans-serif;
  font-size: 2rem;
  font-weight: 800;
  line-height: 1.2;
  text-decoration: none;
}

@media (max-width: 900px) {
  .home-history,
  .home-history__wrap {
    min-height: 0;
  }

  .home-history__wrap {
    padding: 56px 1rem;
  }

  .home-consultation__wrap,
  .home-location__wrap {
    grid-template-columns: 1fr;
  }

  .home-consultation__wrap {
    gap: 2rem;
    padding: 70px 1rem;
  }
}

@media (max-width: 560px) {
  .home-history {
    background-position: 62% center;
  }

  .home-history__wrap {
    padding: 32px .75rem;
  }

  .home-history__card {
    padding: 26px 20px 24px;
    border-radius: 10px;
  }

  .home-history__title {
    margin-bottom: 1.25rem;
    font-size: 1.65rem;
  }

  .home-history__text {
    font-size: .94rem;
    line-height: 1.45;
  }

  .home-history__actions {
    margin-top: 1.5rem;
  }

  .home-history__button {
    width: 100%;
  }

  .home-consultation__wrap,
  .home-location__wrap {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .home-consultation__title,
  .home-location__title {
    font-size: 1.65rem;
  }

  .home-consultation__contacts {
    padding: 26px 20px;
  }

  .home-location__phone {
    font-size: 1.55rem;
  }
}
</style>
