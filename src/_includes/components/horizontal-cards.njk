{% macro horizontalCards(items, columns=none) %}
{% set cols = columns if columns else items.length %}
{% set tabletCols = 2 if cols > 2 else cols %}
{% set figureWidth = '3' if cols <= 3 else '4' %}
<section class="nh-horizontal-cards widget-sort onmain on-view widget-block nh-editor-panel lazyload js-indent" id="horizontal-cards-{{ range(1000,9999) | random }}">
<link href="/assets/css/horizontal-cards.374645.min.css" rel="stylesheet" type="text/css"/>
<div data-ng-non-bindable="" style="--hc-bg-before-color: rgba(245,247,251, 1);">
<div class="lazyload nh-horizontal-cards--indent-top-s nh-horizontal-cards--indent-bottom-l" style="background-position: center; background-repeat: no-repeat; background-size: cover; background-color: rgba(245,247,251, 1);">
<div class="js-indent-add"></div>
<div class="nh-horizontal-cards__inner">
<div class="nh-horizontal-cards__content">
<ul class="nh-horizontal-cards__items nh-horizontal-cards__items--gap-3 nh-horizontal-cards__items--columns-{{ cols }} nh-horizontal-cards__items--columns-tablet-landscape-{{ tabletCols }} nh-horizontal-cards__items--columns-tablet-portrait-{{ tabletCols }} nh-horizontal-cards__items--columns-mobile-1">
{% for item in items %}
<li class="nh-horizontal-cards__item nh-horizontal-cards__item_link-hover nh-horizontal-cards_round-2" style="--border-color: rgba(251,215,149, 0); --border-width: 1px; --shadow-rgba-color: rgba(52,62,69, 0.03); --shadow-offsetX: 0px; --shadow-offsetY: 4px; --shadow-blur: 25px;">
<div class="lazyload" style="height: 100%; --hc-item-bg-before-color: rgba(255,255,255, 1); background-position: center; background-repeat: no-repeat; background-size: cover; background-color: rgba(255,255,255, 1);">
{% if item.link %}<a href="{{ item.link }}" target="_parent">{% endif %}
<figure class="nh-horizontal-cards__item--width-{{ figureWidth }}" style="--img-border-color: rgba(0,0,0, 0); --img-border-width: 6px; --image-shadow-rgba-color: rgba(0,0,0, 0); --image-shadow-offsetX: 0px; --image-shadow-offsetY: 4px; --image-shadow-blur: 25px;">
<div class="nh-horizontal-cards__picture-container">
<picture class="nh-horizontal-cards__picture-container nh-horizontal-cards_round-2" style="">
<img alt="{{ item.image.alt or '' }}" class="nh-horizontal-cards_round-2" loading="lazy" sizes="(max-width: 767px) 656px, (min-width: 768px) 656px" src="{{ item.image.src }}"/>
</picture>
</div>
<div class="nh-horizontal-cards__info nh-horizontal-cards__info--alignment-1" style="">
{% if item.title %}
<div class="nh-horizontal-cards__title nh-horizontal-cards-item-title--user-inner" style="color: #102748; text-align: left;">
<h6 class="nh-text-editor__fontsize-20">{{ item.title }}</h6>
</div>
{% endif %}
<div class="nh-horizontal-cards__text nh-horizontal-cards-item-desc--user-inner" style="color: #102748;">
<p class="nh-text-editor__fontsize-14">{{ item.text }}</p>
</div>
</div>
</figure>
{% if item.link %}</a>{% endif %}
</div>
</li>
{% endfor %}
</ul>
</div>
</div>
</div>
</div>
</section>
{% endmacro %}
