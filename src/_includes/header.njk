<div class="nh-topbar-links nh-topbar--hide-1" id="nh-topbar-links-2-2-1">
{% for item in navigation %}
<a class="nh-topbar-link nh-topbar-link__font nh-topbar-link__font--14 nh-topbar-link__font--none nh-topbar-link__font--paragraph{% if activePage == item.url %} nh-topbar-link--active{% endif %}" href="{{ item.url }}" style="--nh-topbar-link-color:#102748;--nh-topbar-link-hover:#3384BF;--nh-topbar-link-active:#3384BF;" target="_parent">
{{ item.label }}
</a>{% endfor %}
</div><button class="nh-topbar-links__btn nh-topbar--hide-1 nh-topbar-link__font--14 nh-topbar-link__font--none nh-topbar-link__font--paragraph nh-topbar-link__font--underline-2" id="move-links-btn-2-2-1" type="button" aria-label="Открыть меню" aria-controls="nh-topbar-overlay" aria-expanded="false" style="color:#F5F1FE">
<svg fill="currentColor" height="6" viewbox="0 0 12 6" width="12" xmlns="http://www.w3.org/2000/svg"><path d="M6 6l5.2-6H.8L6 6z"></path></svg>
</button>
<div class="nh-mobile-menu-source" id="nh-mobile-menu-source" aria-hidden="true">
  <ul class="nh-mobile-menu__groups">
  {% for item in burgerNavigation %}
    <li class="nh-mobile-menu__group">
      <a class="nh-mobile-menu__group-title" href="{{ item.url }}" target="_parent">
        <span>{{ item.label }}</span>
        <span class="nh-mobile-menu__arrow" aria-hidden="true">↗</span>
      </a>
      {% if item.children %}
      <ul class="nh-mobile-menu__subitems">
        {% for child in item.children %}
        <li>
          <span class="nh-mobile-menu__bullet" aria-hidden="true"></span>
          <a href="{{ child.url }}" target="_parent">{{ child.label }}</a>
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </li>
  {% endfor %}
  </ul>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var source = document.getElementById('nh-topbar-links-2-2-1');
    var mobileSource = document.getElementById('nh-mobile-menu-source');
    var overlay = document.getElementById('nh-topbar-overlay');
    var content = document.getElementById('nh-topbar-overlay-content');
    var closeButton = document.getElementById('nh-topbar-overlay-close');
    var lastTrigger = null;

    function setMenuTriggerState(isOpen) {
        document.querySelectorAll('.nh-topbar-mobile-menu, #move-links-btn-2-2-1').forEach(function (button) {
            button.setAttribute('aria-expanded', String(isOpen));
        });
    }

    function getFocusableElements() {
        if (!overlay) return [];

        return Array.prototype.slice.call(overlay.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )).filter(function (element) {
            return !element.hidden && element.offsetParent !== null;
        });
    }

    function openSiteTopbarOverlay(menuSource, trigger) {
        if (!menuSource || !overlay || !content) {
            return;
        }

        lastTrigger = trigger || null;
        content.innerHTML = menuSource.innerHTML;
        content.classList.toggle('nh-topbar-overlay-content--mobile', menuSource === mobileSource);
        overlay.classList.add('is-open');
        overlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('nh-topbar-overlay-open');
        setMenuTriggerState(true);
        if (closeButton) closeButton.focus();
    }

    function closeSiteTopbarOverlay() {
        if (!overlay) {
            return;
        }

        overlay.classList.remove('is-open');
        overlay.setAttribute('aria-hidden', 'true');
        content.classList.remove('nh-topbar-overlay-content--mobile');
        document.body.classList.remove('nh-topbar-overlay-open');
        setMenuTriggerState(false);
        if (lastTrigger) lastTrigger.focus();
        lastTrigger = null;
    }

    document.getElementById('move-links-btn-2-2-1').addEventListener('click', function () {
        openSiteTopbarOverlay(source, this);
    });
    document.querySelectorAll('.nh-topbar-mobile-menu').forEach(function (button) {
        button.addEventListener('click', function () {
            openSiteTopbarOverlay(mobileSource, this);
        });
    });

    if (closeButton) {
        closeButton.addEventListener('click', closeSiteTopbarOverlay);
    }

    if (overlay) {
        overlay.addEventListener('click', function (event) {
            if (event.target === this) {
                closeSiteTopbarOverlay();
            }
        });
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeSiteTopbarOverlay();
        }

        if (event.key !== 'Tab' || !overlay || !overlay.classList.contains('is-open')) return;

        var focusable = getFocusableElements();
        if (!focusable.length) return;

        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
        }
    });
});
</script>
</div>
<div class="nh-topbar__column nh-topbar--gap-2 nh-topbar--hide-3 nh-topbar--round-0 nh-topbar__column--vertical-align-center nh-topbar__column--horizontal-align-right nh-topbar--padding-top-1 nh-topbar--padding-bottom-1 nh-topbar--padding-left-0 nh-topbar--padding-right-2 lazyload" style="border: 0 solid rgba(255,255,255, 0);box-shadow: 0px var(--topbar-shadow-y, 4px) var(--topbar-shadow-blur, 24px) 0px transparent;background-position: top center;background-repeat: no-repeat;background-size: 0px;background-color: rgba(255,255,255, 0);">
