<div class="nh-topbar__column nh-topbar--gap-2 nh-topbar--hide-2 nh-topbar--round-0 nh-topbar__column--vertical-align-center nh-topbar__column--horizontal-align-left nh-topbar--padding-top-1 nh-topbar--padding-bottom-1 nh-topbar--padding-left-1 nh-topbar--padding-right-0 lazyload" style="border: 0 solid rgba(255,255,255, 0);box-shadow: 0px var(--topbar-shadow-y, 4px) var(--topbar-shadow-blur, 24px) 0px transparent;background-position: top center;background-repeat: no-repeat;background-size: 0px;background-color: rgba(255,255,255, 0);">
