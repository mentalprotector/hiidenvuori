<link href="/assets/css/topbar.20562c.min.css" rel="stylesheet" type="text/css"/>
<style>
.nh-topbar.site-header {
  background: transparent !important;
  left: 0 !important;
  margin: 0 !important;
  max-width: none !important;
  padding-top: 1.25rem !important;
  position: absolute !important;
  right: 0 !important;
  top: 0 !important;
  width: 100% !important;
  z-index: 10000 !important;
}
.nh-topbar.site-header .nh-topbar-wrapper {
  margin-left: auto !important;
  margin-right: auto !important;
  max-width: 82rem !important;
}
.nh-topbar.site-header .nh-topbar-link {
  color: #102748 !important;
  font-family: FontParagraph, Manrope, Arial, Helvetica, sans-serif !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  line-height: 1.4 !important;
  padding-left: 0.625rem !important;
  padding-right: 0.625rem !important;
  text-decoration: none !important;
}
.nh-topbar.site-header .nh-topbar-link:hover,
.nh-topbar.site-header .nh-topbar-link--active {
  color: #3384bf !important;
}

.nh-topbar-overlay {
  background: rgba(16, 39, 72, 0.96);
  bottom: 0;
  display: none;
  left: 0;
  overflow-y: auto;
  position: fixed;
  right: 0;
  top: 0;
  z-index: 10002 !important;
}

.nh-topbar-overlay.is-open {
  display: block;
}

.nh-topbar-overlay-close {
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 999px;
  display: flex;
  height: 44px;
  justify-content: center;
  position: absolute;
  right: 1rem;
  top: 1rem;
  width: 44px;
}

.nh-topbar-overlay-close svg,
.nh-topbar-overlay-close path {
  fill: #ffffff !important;
}

.nh-topbar-overlay-content {
  padding: 5.5rem 1.5rem 2rem;
}

.nh-topbar-overlay-content a,
.nh-topbar-overlay-content .nh-topbar-link {
  color: #ffffff !important;
  display: block !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  line-height: 1.25 !important;
  opacity: 1 !important;
  padding: 0.8rem 0 !important;
  text-decoration: none !important;
  visibility: visible !important;
}

.nh-topbar.site-header .nh-topbar-overlay-content a,
.nh-topbar.site-header .nh-topbar-overlay-content .nh-topbar-link {
  color: #ffffff !important;
}

body.nh-topbar-overlay-open {
  overflow: hidden !important;
}

@media screen and (max-width: 47.998rem) {
  .nh-topbar.site-header .nh-topbar-wrapper {
    box-sizing: border-box;
    width: 100% !important;
  }

  .nh-topbar.site-header .nh-topbar__row-middle {
    box-sizing: border-box !important;
    display: flex !important;
    max-width: 100% !important;
    width: 100% !important;
  }

  .nh-topbar.site-header .nh-topbar__row-middle > .nh-topbar__column:first-child {
    align-items: center !important;
    display: flex !important;
    flex: 1 1 auto !important;
    gap: 0.75rem !important;
    min-width: 0 !important;
    width: 100% !important;
  }

  .nh-topbar.site-header .nh-topbar-logo-svg {
    width: 215px !important;
    max-width: 100% !important;
    height: auto !important;
  }

  .nh-topbar-mobile-actions {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 0;
    margin-left: auto;
  }

.nh-topbar-mobile-action {
  align-items: center;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  color: #243b5c;
  display: inline-flex;
  height: 44px;
  justify-content: center;
  width: 44px;
}

  .nh-topbar-mobile-menu {
    cursor: pointer;
  }

.nh-topbar-mobile-menu svg {
  display: block !important;
  height: 24px !important;
  width: 24px !important;
}
}

@media screen and (min-width: 48rem) {
  .nh-topbar-mobile-actions {
    display: none;
  }

  .nh-topbar.site-header .nh-topbar__row-middle > .nh-topbar__column:nth-child(2) {
    transform: translateX(clamp(3rem, 7vw, 7rem));
  }
}
</style>
